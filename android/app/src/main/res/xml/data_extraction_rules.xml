<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup / device-to-device transfer rules.
  Wajah backup_rules.xml jaisi hi hai - keystore key transfer nahi hoti.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
