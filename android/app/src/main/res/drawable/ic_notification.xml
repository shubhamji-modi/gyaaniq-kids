<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar (small) notification icon.

     Android draws the small icon as a flat silhouette: only the alpha channel
     survives, every colored pixel is repainted white. The brand PNG is a fully
     opaque rounded square, so using it here would show as a white blob — this
     is a monochrome book + bulb mark matching it instead. The full-color PNG is
     used as the large icon (see ic_notification_large). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <!-- Bulb -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,1.8C9.68,1.8 7.8,3.68 7.8,6c0,1.5 0.79,2.82 1.97,3.56v1.09h4.46V9.56C15.41,8.82 16.2,7.5 16.2,6C16.2,3.68 14.32,1.8 12,1.8z" />
    <!-- Bulb base -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M9.77,11.5h4.46v1.15H9.77z" />

    <!-- Open book, left page -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M2,14.3c2.6,-1.6 6.1,-1.3 9.1,0.2v6.9c-3,-1.5 -6.5,-1.8 -9.1,-0.2z" />
    <!-- Open book, right page -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M22,14.3c-2.6,-1.6 -6.1,-1.3 -9.1,0.2v6.9c3,-1.5 6.5,-1.8 9.1,-0.2z" />
</vector>
